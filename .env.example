# Makanan Enterprise Environment Template
# Copy this file to .env.docker and replace with your secrets

# PostgreSQL Database Configuration
POSTGRES_DB=makanan
POSTGRES_USER=makanan_admin
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://makanan_admin:change_this_to_a_secure_password@db:5432/makanan
LOCAL_DATABASE_URL=postgresql+asyncpg://makanan_admin:change_this_to_a_secure_password@localhost:5433/makanan

# Redis Configuration
REDIS_PASSWORD=change_this_to_a_secure_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:change_this_to_a_secure_redis_password@redis:6379/0
LOCAL_REDIS_URL=redis://:change_this_to_a_secure_redis_password@localhost:6379/0

# Security Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET=generate_random_64_hex_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
QR_SECRET=generate_random_64_hex_chars_here

# Malaysian Payment Gateway Settings (DuitNow QR & E-Wallets)
PAYMENT_MODE=sandbox
DUITNOW_MERCHANT_ID=MKN-PAYNET-AIU01
DUITNOW_MERCHANT_NAME=Makanan AIU
TNG_MERCHANT_ID=TNG-MKN-AIU-001
GRABPAY_MERCHANT_ID=GRAB-MKN-AIU-001
SHOPEEPAY_MERCHANT_ID=SHOPEE-MKN-AIU-001

# Transactional Notifications
RESEND_API_KEY=your-resend-api-key-here
SUPPORT_EMAIL=support@makanan.app

# API & Frontend URLs
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:4028,http://127.0.0.1:3000,http://127.0.0.1:4028
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
